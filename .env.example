# Port to run backend server
PORT=5000

# MongoDB URI connection string
MONGODB_URI=mongodb://localhost:27017/careflow

# Authentication Configuration
JWT_SECRET=supersecretjwtkey_replace_this_in_production
JWT_EXPIRES_IN=1h

# Google Calendar OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Google Gemini API Key
GEMINI_API_KEY=placeholder_gemini_api_key

# Email Notification Configuration (Nodemailer or similar)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=placeholder_email_user
EMAIL_PASSWORD=placeholder_email_password
EMAIL_FROM=noreply@careflow.com

# Frontend URL configuration
FRONTEND_URL=http://localhost:5173
